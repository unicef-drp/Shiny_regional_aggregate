\name{run_app}
\alias{run_app}
\title{Run the regional aggregate Shiny application}
\usage{
run_app(...)
}
\arguments{
  \item{...}{Arguments passed to \code{\link[shiny:shinyApp]{shiny::shinyApp()}}.}
}
\value{
  A \code{shiny.appobj}.
}
\description{
  Launches the packaged Shiny application for uploading a Region / ISO3Code
  file and downloading long-format aggregate results.
}
